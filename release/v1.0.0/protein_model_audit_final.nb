Cell["Uncertainty of the Primary Contrast", "Section",
 CellChangeTimes->{
  3.997332178255951*^9},ExpressionUUID->"3bbe1a09-5ad6-4410-bdf5-\
cdac29fb9340"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"boot", "=", 
   RowBox[{"authority", "[", "\"\<bootstrap_C_minus_A\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ci", "=", 
    RowBox[{"boot", "[", "\"\<ci95\>\"", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"uncertaintyPanel", "=", 
    RowBox[{"Panel", "[", 
     RowBox[{"Grid", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<Primary contrast\>\"", ",", "\"\<C - A\>\""}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\"\<Observed delta\>\"", ",", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"boot", "[", "\"\<delta\>\"", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"6", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\"\<95% bootstrap CI\>\"", ",", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<[\>\"", ",", 
              RowBox[{"NumberForm", "[", 
               RowBox[{
                RowBox[{"ci", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"6", ",", "4"}], "}"}]}], "]"}], ",", "\"\<, \>\"", ",", 
              RowBox[{"NumberForm", "[", 
               RowBox[{
                RowBox[{"ci", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"6", ",", "4"}], "}"}]}], "]"}], ",", "\"\<]\>\""}], 
             "}"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\"\<Bootstrap replicates\>\"", ",", 
           RowBox[{"boot", "[", "\"\<n_boot\>\"", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\"\<ECOD H-groups\>\"", ",", 
           RowBox[{"boot", "[", "\"\<n_h_groups\>\"", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\"\<Interval excludes zero\>\"", ",", 
           RowBox[{"Not", "[", 
            RowBox[{
             RowBox[{"ci", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "<=", "0", "<=", 
             RowBox[{"ci", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "}"}]}], "}"}], ",", 
       
       RowBox[{"Frame", "->", "All"}], ",", 
       RowBox[{"Alignment", "->", "Left"}], ",", 
       RowBox[{"Spacings", "->", 
        RowBox[{"{", 
         RowBox[{"2", ",", "1"}], "}"}]}]}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", "uncertaintyPanel"}], "Input",
 CellChangeTimes->{3.99733224885439*^9, 3.997334685322892*^9, 

    RowBox[{"AllTrue", "[", 
     RowBox[{
      RowBox[{"Values", "[", "nullSummary", "]"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", "#", "]"}], "<", "0.1"}], "&"}]}], "]"}]}]}], 
  "}"}]}], "Input",

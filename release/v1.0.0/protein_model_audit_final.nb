Cell[CellGroupData[{

Cell["H-Group Performance Landscape", "Section",
 CellChangeTimes->{
  3.997332059521809*^9},ExpressionUUID->"79a9d6d0-4889-4142-86c7-\
537df5ec29f6"],

Cell["\<\
Each point represents one ECOD H-group. Points above the diagonal indicate \
H-groups where the graph-enhanced model C outperforms the angular-only model \
A.\
\>", "Text",
 CellChangeTimes->{
  3.997332073433527*^9},ExpressionUUID->"ef9521f3-79dc-4ba9-a37c-\
e850ceaf3548"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"scatterPoints", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", "[", "\"\<A\>\"", "]"}], ",", 
         RowBox[{"#", "[", "\"\<C\>\"", "]"}]}], "}"}], "&"}], ")"}], "/@", 
     RowBox[{"Values", "[", "hGroupMetrics", "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"deltas", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "-", 
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "&"}], "/@", "scatterPoints"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"nCFavor", "=", 
   RowBox[{"Count", "[", 
    RowBox[{"deltas", ",", 
     RowBox[{"x_", "/;", 
      RowBox[{"x", ">", "0"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nAFavor", "=", 
    RowBox[{"Count", "[", 
     RowBox[{"deltas", ",", 
      RowBox[{"x_", "/;", 
       RowBox[{"x", "<", "0"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"rangeMin", "=", 
   RowBox[{
    RowBox[{"Min", "[", 
     RowBox[{"Flatten", "[", "scatterPoints", "]"}], "]"}], "-", "0.08"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rangeMax", "=", 
    RowBox[{
     RowBox[{"Max", "[", 
      RowBox[{"Flatten", "[", "scatterPoints", "]"}], "]"}], "+", "0.08"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hGroupScatter", "=", 
    RowBox[{"ListPlot", "[", 
     RowBox[{"scatterPoints", ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"Axes", "->", "False"}], ",", 
      RowBox[{"AspectRatio", "->", "1"}], ",", 
      RowBox[{"ImageSize", "->", "800"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<Angular-only model A: H-group Spearman rho\>\"", 
         ",", "\"\<Graph-enhanced model C: H-group Spearman rho\>\""}], 
        "}"}]}], ",", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"rangeMin", ",", "rangeMax"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"rangeMin", ",", "rangeMax"}], "}"}]}], "}"}]}], ",", 
      RowBox[{
      "PlotLabel", 
       "->", "\"\<Graph-Enhanced vs Angular-Only Performance Across 59 ECOD \
H-Groups\>\""}], ",", 
      RowBox[{"Epilog", "->", 
       RowBox[{"{", 
        RowBox[{"Dashed", ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"rangeMin", ",", "rangeMin"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"rangeMax", ",", "rangeMax"}], "}"}]}], "}"}], "]"}], ",", 
         RowBox[{"PointSize", "[", "0.02", "]"}], ",", 
         RowBox[{"Point", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"macroH", "[", "\"\<A\>\"", "]"}], ",", 
            RowBox[{"macroH", "[", "\"\<C\>\"", "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            
            RowBox[{"\"\<Macro-H\\nA = 0.1143\\nC = 0.3366\\nDelta = \
+0.2223\>\"", ",", "11", ",", "Bold"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"macroH", "[", "\"\<A\>\"", "]"}], ",", 
             RowBox[{"macroH", "[", "\"\<C\>\"", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1.3"}], ",", 
             RowBox[{"-", "1.2"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"ToString", "[", "nCFavor", "]"}], 
              "<>", "\"\< groups favor C | \>\"", "<>", 
              RowBox[{"ToString", "[", "nAFavor", "]"}], 
              "<>", "\"\< favor A\>\""}], ",", "11"}], "]"}], ",", 
           RowBox[{"Scaled", "[", 
            RowBox[{"{", 
             RowBox[{"0.72", ",", "0.08"}], "}"}], "]"}]}], "]"}]}], 
        "}"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", "hGroupScatter"}], "Input",
 CellChangeTimes->{3.997332089030423*^9},
 CellLabel->"In[69]:=",ExpressionUUID->"25a202dd-8480-4ed2-875f-2ffadf209791"],


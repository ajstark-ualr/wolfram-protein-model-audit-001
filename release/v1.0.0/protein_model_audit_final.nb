Cell[CellGroupData[{

Cell["Per-Protein Reconstruction", "Section",
 CellChangeTimes->{{3.997330822287922*^9, 
  3.997330842400035*^9}},ExpressionUUID->"2ee54094-0ccc-4f3e-97e8-\
3ab1ec253d43"],

Cell["\<\
For each protein, Spearman correlation is computed across its 20 held-out \
residue predictions. This produces one correlation score per protein for each \
model arm before any homology-group aggregation.\
\>", "Text",
 CellChangeTimes->{
  3.9973308535246572`*^9},ExpressionUUID->"f529c29e-4897-4400-9b53-\
97b4a7be6375"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"byProtein", "=", 
    RowBox[{"GroupBy", "[", 
     RowBox[{"rows", ",", 
      RowBox[{
       RowBox[{"#", "[", "\"\<protein_id\>\"", "]"}], "&"}]}], "]"}]}], ";"}],
   "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"proteinMetrics", "=", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{"pRows", ",", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<A\>\"", "->", 
           RowBox[{"SpearmanRho", "[", 
            RowBox[{
             RowBox[{"Lookup", "[", 
              RowBox[{"pRows", ",", "\"\<target_y\>\""}], "]"}], ",", 
             RowBox[{"Lookup", "[", 
              RowBox[{"pRows", ",", "\"\<pred_A\>\""}], "]"}]}], "]"}]}], ",", 
          RowBox[{"\"\<C\>\"", "->", 
           RowBox[{"SpearmanRho", "[", 
            RowBox[{
             RowBox[{"Lookup", "[", 
              RowBox[{"pRows", ",", "\"\<target_y\>\""}], "]"}], ",", 
             RowBox[{"Lookup", "[", 
              RowBox[{"pRows", ",", "\"\<pred_C\>\""}], "]"}]}], "]"}]}], ",", 
          RowBox[{"\"\<A_attr_control\>\"", "->", 
           RowBox[{"SpearmanRho", "[", 
            RowBox[{
             RowBox[{"Lookup", "[", 
              RowBox[{"pRows", ",", "\"\<target_y\>\""}], "]"}], ",", 
             RowBox[{"Lookup", "[", 
              RowBox[{"pRows", ",", "\"\<pred_A_attr_control\>\""}], "]"}]}], 
            "]"}]}], ",", 
          RowBox[{"\"\<plddt\>\"", "->", 
           RowBox[{"SpearmanRho", "[", 
            RowBox[{
             RowBox[{"Lookup", "[", 
              RowBox[{"pRows", ",", "\"\<target_y\>\""}], "]"}], ",", 
             RowBox[{"Lookup", "[", 
              RowBox[{"pRows", ",", "\"\<pred_plddt\>\""}], "]"}]}], 
            "]"}]}]}], "|>"}]}], "]"}], ",", "byProtein"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"macroProtein", "=", 
    RowBox[{"AssociationMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Mean", "[", 
        RowBox[{"Lookup", "[", 
         RowBox[{
          RowBox[{"Values", "[", "proteinMetrics", "]"}], ",", "#"}], "]"}], 
        "]"}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<A\>\"", ",", "\"\<C\>\"", ",", "\"\<A_attr_control\>\"", 
        ",", "\"\<plddt\>\""}], "}"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<Proteins\>\"", "->", 
    RowBox[{"Length", "[", "proteinMetrics", "]"}]}], ",", 
   RowBox[{"\"\<Residues per protein\>\"", "->", 
    RowBox[{"Counts", "[", 
     RowBox[{"Length", "/@", 
      RowBox[{"Values", "[", "byProtein", "]"}]}], "]"}]}], ",", 
   RowBox[{"\"\<Macro-protein\>\"", "->", "macroProtein"}], ",", 
   RowBox[{"\"\<C - A\>\"", "->", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"macroProtein", "[", "\"\<C\>\"", "]"}], "-", 
      RowBox[{"macroProtein", "[", "\"\<A\>\"", "]"}]}], ")"}]}]}], 
  "}"}]}], "Input",
 CellChangeTimes->{{3.997330864132217*^9, 3.9973308641322327`*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"b52c0cf7-2340-4dd2-bd55-7371266d474b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Proteins\"\>", "\[Rule]", "100"}], ",", 
   RowBox[{"\<\"Residues per protein\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{"20", "\[Rule]", "100"}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"Macro-protein\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"A\"\>", "\[Rule]", "0.10336842105263161`"}], ",", 
      RowBox[{"\<\"C\"\>", "\[Rule]", "0.330796992481203`"}], ",", 
      RowBox[{"\<\"A_attr_control\"\>", "\[Rule]", "0.07180451127819548`"}], ",", 
      RowBox[{"\<\"plddt\"\>", "\[Rule]", "0.35711190337840776`"}]}], 
     "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"C - A\"\>", "\[Rule]", "0.22742857142857137`"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.997330865658168*^9, 3.997338079127047*^9, 
  3.997338112969761*^9},
 CellLabel->"Out[52]=",ExpressionUUID->"80cc50bf-a753-4619-9da7-8fdc9b96b6a5"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Homology-Aware Macro-H Reconstruction", "Section",
 CellChangeTimes->{
  3.9973308976937437`*^9},ExpressionUUID->"8252f86e-d315-4822-b7be-\
215524b9a99f"],

Cell["\<\
To avoid overweighting proteins from the same structural family, \
protein-level scores are grouped by ECOD H-group. Each H-group contributes \
one mean score, and the final Macro-H statistic is the equal-weight mean \
across 59 groups.\
\>", "Text",
 CellChangeTimes->{{3.9973309085041323`*^9, 
  3.9973309154750767`*^9}},ExpressionUUID->"f94697a4-1d01-4658-8ba2-\
dcada23c4196"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"cohort", "=", 
    RowBox[{"Import", "[", 
     RowBox[{"\"\<cohort_selection_manifest.json\>\"", 
      ",", "\"\<RawJSON\>\""}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"proteinToHGroup", "=", 
    RowBox[{"Association", "@", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"g", ",", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"g", "[", "\"\<protein_ids\>\"", "]"}], "->", 
           RowBox[{"g", "[", "\"\<h_group\>\"", "]"}]}], "]"}]}], "]"}], "/@", 
       RowBox[{"cohort", "[", "\"\<h_groups\>\"", "]"}]}], "]"}]}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hGroupProteins", "=", 
    RowBox[{"GroupBy", "[", 
     RowBox[{
      RowBox[{"Keys", "[", "proteinMetrics", "]"}], ",", 
      RowBox[{
       RowBox[{"proteinToHGroup", "[", "#", "]"}], "&"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hGroupMetrics", "=", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{"pids", ",", 
        RowBox[{"AssociationMap", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{"arm", ",", 
            RowBox[{"Mean", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"proteinMetrics", "[", "#", "]"}], "[", "arm", "]"}],
                 "&"}], ")"}], "/@", "pids"}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<A\>\"", ",", "\"\<C\>\"", 
            ",", "\"\<A_attr_control\>\"", ",", "\"\<plddt\>\""}], "}"}]}], 
         "]"}]}], "]"}], ",", "hGroupProteins"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"macroH", "=", 
    RowBox[{"AssociationMap", "[", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{"arm", ",", 
        RowBox[{"Mean", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", "[", "arm", "]"}], "&"}], ")"}], "/@", 
          RowBox[{"Values", "[", "hGroupMetrics", "]"}]}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<A\>\"", ",", "\"\<C\>\"", ",", "\"\<A_attr_control\>\"", 
        ",", "\"\<plddt\>\""}], "}"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<H-groups\>\"", "->", 
    RowBox[{"Length", "[", "hGroupMetrics", "]"}]}], ",", 
   RowBox[{"\"\<Macro-H\>\"", "->", "macroH"}], ",", 
   RowBox[{"\"\<C - A\>\"", "->", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"macroH", "[", "\"\<C\>\"", "]"}], "-", 
      RowBox[{"macroH", "[", "\"\<A\>\"", "]"}]}], ")"}]}]}], "}"}]}], "Input",\

 CellChangeTimes->{{3.997330924698711*^9, 3.9973309246987257`*^9}},
 CellLabel->"In[53]:=",ExpressionUUID->"0905fd29-1c61-4939-a07b-24c900634011"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"H-groups\"\>", "\[Rule]", "59"}], ",", 
   RowBox[{"\<\"Macro-H\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"A\"\>", "\[Rule]", "0.11429845800943035`"}], ",", 
      RowBox[{"\<\"C\"\>", "\[Rule]", "0.3366254619599846`"}], ",", 
      RowBox[{"\<\"A_attr_control\"\>", "\[Rule]", "0.08728176373136232`"}], ",", 
      RowBox[{"\<\"plddt\"\>", "\[Rule]", "0.34552266180522073`"}]}], 
     "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"C - A\"\>", "\[Rule]", "0.22232700395055427`"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.997330925817971*^9, 3.997338079159684*^9, 
  3.9973381130242977`*^9},
 CellLabel->"Out[58]=",ExpressionUUID->"90826f6f-7008-44b6-9696-da398484fb45"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Authority Validation", "Section",
 CellChangeTimes->{
  3.997330996461402*^9},ExpressionUUID->"5dafa4ba-3e2b-497c-af0e-\
e842f50b6ac5"],

Cell["\<\
The reconstructed Macro-H values are compared against the persisted Phase-4A \
results. Agreement to machine precision confirms that the Wolfram \
reconstruction reproduces the stored benchmark statistic without retraining \
any model.\
\>", "Text",
 CellChangeTimes->{
  3.9973310091129704`*^9},ExpressionUUID->"e2a25187-dbeb-4d66-a3d0-\
2a4913ef026e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"authority", "=", 
    RowBox[{"Import", "[", 
     RowBox[{"\"\<results.json\>\"", ",", "\"\<RawJSON\>\""}], "]"}]}], ";"}],
   "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"authorityMacro", "=", 
    RowBox[{"AssociationMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"authority", "[", "\"\<macros\>\"", "]"}], "[", "#", "]"}], 
        "[", "\"\<macro_hgroup_spearman\>\"", "]"}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<A\>\"", ",", "\"\<C\>\"", ",", "\"\<A_attr_control\>\"", 
        ",", "\"\<plddt\>\""}], "}"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"differences", "=", 
    RowBox[{"AssociationMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"macroH", "[", "#", "]"}], "-", 
        RowBox[{"authorityMacro", "[", "#", "]"}]}], "&"}], ",", 
      RowBox[{"Keys", "[", "authorityMacro", "]"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<Reconstruction\>\"", "->", "macroH"}], ",", 
   RowBox[{"\"\<Stored authority\>\"", "->", "authorityMacro"}], ",", 
   RowBox[{"\"\<Max absolute difference\>\"", "->", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{"Values", "[", "differences", "]"}], "]"}], "]"}]}], ",", 
   RowBox[{"\"\<PASS\>\"", "->", 
    RowBox[{"(", 
     RowBox[{

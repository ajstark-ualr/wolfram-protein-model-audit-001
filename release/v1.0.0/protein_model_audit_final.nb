Cell["\<\
The primary Macro-H contrast is +0.2223, with a 95% H-group bootstrap \
confidence interval of [+0.1626, +0.2836]. Because the interval remains above \
zero, the improvement of model C over model A is supported across the \
homology-aware evaluation rather than being driven solely by the point \
estimate.\
\>", "Text",
 CellChangeTimes->{{3.9973322624595222`*^9, 
  3.997332266301674*^9}},ExpressionUUID->"c3156470-e682-4583-b353-\
50a3abad241c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Interactive H-Group Explorer", "Section",
 CellChangeTimes->{
  3.997332353569537*^9},ExpressionUUID->"8660dacd-619b-4f50-b7a5-\
72ef46b1e126"],

Cell["\<\
Select an ECOD H-group to inspect its constituent proteins, compare model A \
and model C, and locate that group within the full performance landscape.\
\>", "Text",
 CellChangeTimes->{
  3.997332361802109*^9},ExpressionUUID->"a4a85c97-8c99-4714-8906-\
e002cbb9968f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"groupKeys", "=", 
    RowBox[{"Sort", "[", 
     RowBox[{"Keys", "[", "hGroupMetrics", "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"m", "=", 
        RowBox[{"hGroupMetrics", "[", "hg", "]"}]}], ",", 
       RowBox[{"pids", "=", 
        RowBox[{"hGroupProteins", "[", "hg", "]"}]}]}], "}"}], ",", 
     RowBox[{"Column", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Panel", "[", 
          RowBox[{"Grid", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\"\<ECOD H-group\>\"", ",", "hg"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"\"\<Proteins\>\"", ",", 
                RowBox[{"Length", "[", "pids", "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"\"\<Model A\>\"", ",", 
                RowBox[{"NumberForm", "[", 
                 RowBox[{
                  RowBox[{"m", "[", "\"\<A\>\"", "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"5", ",", "3"}], "}"}]}], "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"\"\<Model C\>\"", ",", 
                RowBox[{"NumberForm", "[", 
                 RowBox[{
                  RowBox[{"m", "[", "\"\<C\>\"", "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"5", ",", "3"}], "}"}]}], "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"\"\<C - A\>\"", ",", 
                RowBox[{"NumberForm", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"m", "[", "\"\<C\>\"", "]"}], "-", 
                   RowBox[{"m", "[", "\"\<A\>\"", "]"}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"5", ",", "3"}], "}"}]}], "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"\"\<Favors\>\"", ",", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"m", "[", "\"\<C\>\"", "]"}], ">", 
                   RowBox[{"m", "[", "\"\<A\>\"", "]"}]}], 
                  ",", "\"\<Graph-enhanced C\>\"", 
                  ",", "\"\<Angular-only A\>\""}], "]"}]}], "}"}]}], "}"}], ",", 
            RowBox[{"Frame", "->", "All"}], ",", 
            RowBox[{"Alignment", "->", "Left"}], ",", 
            RowBox[{"Spacings", "->", 
             RowBox[{"{", 
              RowBox[{"2", ",", "1"}], "}"}]}]}], "]"}], "]"}], ",", 
         RowBox[{"Dataset", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<Protein\>\"", "->", "#"}], ",", 
               RowBox[{"\"\<A\>\"", "->", 
                RowBox[{
                 RowBox[{"proteinMetrics", "[", "#", "]"}], "[", "\"\<A\>\"", 
                 "]"}]}], ",", 
               RowBox[{"\"\<C\>\"", "->", 
                RowBox[{
                 RowBox[{"proteinMetrics", "[", "#", "]"}], "[", "\"\<C\>\"", 
                 "]"}]}], ",", 
               RowBox[{"\"\<C - A\>\"", "->", 
                RowBox[{
                 RowBox[{
                  RowBox[{"proteinMetrics", "[", "#", "]"}], "[", "\"\<C\>\"",
                   "]"}], "-", 
                 RowBox[{
                  RowBox[{"proteinMetrics", "[", "#", "]"}], "[", "\"\<A\>\"",
                   "]"}]}]}]}], "|>"}], ")"}], "&"}], "/@", "pids"}], "]"}], ",", 
         RowBox[{"Show", "[", 
          RowBox[{"hGroupScatter", ",", 
           RowBox[{"Graphics", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Directive", "[", 
               RowBox[{"Red", ",", 
                RowBox[{"PointSize", "[", "0.03", "]"}]}], "]"}], ",", 
              RowBox[{"Point", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"m", "[", "\"\<A\>\"", "]"}], ",", 
                 RowBox[{"m", "[", "\"\<C\>\"", "]"}]}], "}"}], "]"}], ",", 
              RowBox[{"Text", "[", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{
                  RowBox[{"\"\<Selected: \>\"", "<>", 
                   RowBox[{"ToString", "[", "hg", "]"}]}], ",", "12", ",", 
                  "Bold", ",", "Red"}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"m", "[", "\"\<A\>\"", "]"}], ",", 
                  RowBox[{"m", "[", "\"\<C\>\"", "]"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"0", ",", 
                  RowBox[{"-", "1.5"}]}], "}"}]}], "]"}]}], "}"}], "]"}], ",", 
           RowBox[{"ImageSize", "->", "650"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"Spacings", "->", "2"}]}], "]"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"hg", ",", 
       RowBox[{"First", "[", "groupKeys", "]"}], 
       ",", "\"\<ECOD H-group\>\""}], "}"}], ",", "groupKeys", ",", 
     RowBox[{"ControlType", "->", "PopupMenu"}]}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{3.997332372796402*^9, 3.997332531064227*^9},
 CellLabel->"In[81]:=",ExpressionUUID->"ac2ee2c5-d963-430d-8df5-db8513ba54f6"],


Cell[CellGroupData[{

Cell["Structural Null Audit", "Section",
 CellChangeTimes->{
  3.9973311733321867`*^9},ExpressionUUID->"24d8fb17-de68-407c-926c-\
7ce624544ff0"],

Cell["\<\
Structural null controls deliberately break the relationship between the \
biological target and the model predictions. If the benchmark signal is \
meaningful, these scrambled controls should collapse toward zero rather than \
preserve the real-data performance.\
\>", "Text",
 CellChangeTimes->{
  3.9973312025333157`*^9},ExpressionUUID->"d2cd88d4-6f7e-4a99-b713-\
a3a9b8b00d5f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"nulls", "=", 
    RowBox[{"Import", "[", 
     RowBox[{"\"\<null_results.json\>\"", ",", "\"\<RawJSON\>\""}], "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nullSummary", "=", 
    RowBox[{"AssociationMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"nulls", "[", "\"\<macros\>\"", "]"}], "[", "#", "]"}], 
        "[", "\"\<macro_hgroup_spearman\>\"", "]"}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<A_null_global\>\"", ",", "\"\<A_null_within\>\"", 
        ",", "\"\<A_attr_control_null_global\>\"", 
        ",", "\"\<A_attr_control_null_within\>\"", 
        ",", "\"\<C_null_global\>\"", ",", "\"\<C_null_within\>\""}], "}"}]}],
      "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
